            asteroid_points,
            (90, 90, 95)
        )

        arcade.draw_polygon_outline(
            asteroid_points,
            arcade.color.WHITE,
            1
        )

        arcade.draw_text(
            "— АСТЕРОИД (+10)",
            110,
            y - 5,
            arcade.color.WHITE,
            15,
            font_name="Arial"
