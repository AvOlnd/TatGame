# ============================================================
# ЙОЛДЫЗ
# ============================================================

class Star:

    def __init__(
        self,
        x,
        y,
        size,
        color,
        twinkle_speed,
        twinkle_offset
    ):
        self.x = x
        self.y = y
        self.size = size
        self.color = color
        self.twinkle_speed = twinkle_speed
        self.twinkle_offset = twinkle_offset

    def update(self, delta_time):

        self.y -= STAR_SPEED * delta_time * 6

        if self.y < 0:
            self.y = SCREEN_HEIGHT + random.uniform(0, 50)
            self.x = random.uniform(0, SCREEN_WIDTH)

    def draw(self, time):

        brightness = (
            0.5
            + 0.5 * math.sin(
                time * self.twinkle_speed
                + self.twinkle_offset
            )
        )

        alpha = int(
            150 + 105 * brightness
        )

        arcade.draw_circle_filled(
            self.x,
            self.y,
            self.size,
            (*self.color, alpha)
        )


# ============================================================
# КИСӘКЛӘР
# ============================================================

class Particle:

    def __init__(
        self,
        x,
        y,
        vx,
        vy,
        size,
        color,
        life
    ):
        self.x = x
        self.y = y
        self.vx = vx
        self.vy = vy
        self.size = size
        self.color = color
        self.life = life
        self.age = 0

    def update(self, delta_time):

        self.x += self.vx
        self.y += self.vy
        self.age += delta_time

    def is_alive(self):

        return self.age < self.life

    def draw(self):

        alpha = int(
            255 * max(
                0,
                1 - self.age / self.life
            )
        )

        arcade.draw_circle_filled(
            self.x,
            self.y,
            self.size,
            (*self.color, alpha)
        )


# ============================================================
# ПУЛЯ
# ============================================================

class Bullet:

    def __init__(self, x, y):

        self.x = x
        self.y = y
        self.speed = BULLET_SPEED

    def update(self, delta_time):

        self.y += self.speed

    def draw(self):

        # Яктылык
        arcade.draw_circle_filled(
            self.x,
            self.y + 10,
            5,
            (255, 255, 150)
        )

        # Пуля
        arcade.draw_lrbt_rectangle_filled(
            self.x - 3,
            self.x + 3,
            self.y - 10,
            self.y + 10,
            arcade.color.YELLOW
        )

        arcade.draw_lrbt_rectangle_outline(
            self.x - 3,
            self.x + 3,
            self.y - 10,
            self.y + 10,
            arcade.color.ORANGE,
            1
        )


