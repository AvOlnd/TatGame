class Asteroid:

    def __init__(
        self,
        x,
        y,
        size,
        speed_x,
        speed_y,
        kind
    ):
        self.x = x
        self.y = y
        self.size = size

        self.speed_x = speed_x
        self.speed_y = speed_y

        # Төр:
        #
        # ASTEROID
        # ECHPOCHMAK
        # ELESH
        # CHAK_CHACK
        self.kind = kind

        # Барлык объектлар 2 пулядан юк ителә
        self.health = 2

        self.rotation = random.uniform(
            0,
            360
        )

        self.rotation_speed = random.uniform(
            -80,
            80
        )

        # Астероид формасы
        self.asteroid_radii = []

        for _ in range(10):

            self.asteroid_radii.append(
                random.uniform(
                    0.80,
                    1.10
                )
            )

    # ========================================================
    # ХӘРӘКӘТ
    # ========================================================

    def update(self, delta_time):

        self.x += self.speed_x
        self.y += self.speed_y

        self.rotation += (
            self.rotation_speed
            * delta_time
        )

    # ========================================================
    # БӘРЕЛЕШ
    # ========================================================

    def collides_with(
        self,
        other_x,
        other_y,
        radius
    ):

        dx = self.x - other_x
        dy = self.y - other_y

        return (
            dx * dx + dy * dy
            < (self.size + radius) ** 2
        )

    # ========================================================
    # ЧЫН АСТЕРОИД
    # ========================================================

    def draw_real_asteroid(self):

        points = []

        for i in range(10):

            angle = math.radians(
                self.rotation
                + i * 36
            )

            radius = (
                self.size
                * self.asteroid_radii[i]
            )

            x = (
                self.x
                + math.cos(angle) * radius
            )

            y = (
                self.y
                + math.sin(angle) * radius
            )

            points.append(
                (x, y)
            )

        # Төп форма
        arcade.draw_polygon_filled(
            points,
            (90, 90, 95)
        )

        # Эчке өлеш
        inner_points = []

        for i in range(10):

            angle = math.radians(
                self.rotation
                + i * 36
            )

            radius = (
                self.size
                * self.asteroid_radii[i]
                * 0.88
            )

            x = (
                self.x
                + math.cos(angle) * radius
            )

            y = (
                self.y
                + math.sin(angle) * radius
            )

            inner_points.append(
                (x, y)
            )

        arcade.draw_polygon_filled(
            inner_points,
            (110, 110, 115)
        )

        # Контур
        arcade.draw_polygon_outline(
            points,
            arcade.color.WHITE,
            2
        )

        # Кратерлар
        crater_positions = [
            (-0.30, 0.25, 0.13),
            (0.30, 0.15, 0.10),
            (-0.10, -0.30, 0.15),
            (0.35, -0.35, 0.08)
        ]

        for (
            px,
            py,
            crater_radius
        ) in crater_positions:

            arcade.draw_circle_filled(
                self.x
                + px * self.size,
                self.y
                + py * self.size,
                crater_radius * self.size,
                (55, 55, 60)
            )

            arcade.draw_circle_outline(
                self.x
                + px * self.size,
                self.y
                + py * self.size,
                crater_radius * self.size,
                (145, 145, 150),
                1
            )

    # ========================================================
    # ЭЧПОЧМАК
    # ========================================================

    def draw_echpochmak(self):

        center_x = self.x
        center_y = self.y

        points = []

        base_points = [
            (0, self.size),
            (
                -self.size * 0.95,
                -self.size * 0.70
            ),
            (
                self.size * 0.95,
                -self.size * 0.70
            )
        ]

        angle = math.radians(
            self.rotation
        )

        for px, py in base_points:

            rx = (
                px * math.cos(angle)
                - py * math.sin(angle)
            )

            ry = (
                px * math.sin(angle)
                + py * math.cos(angle)
            )

            points.append(
                (
                    center_x + rx,
                    center_y + ry
                )
            )

        # Төп камыр
        arcade.draw_polygon_filled(
            points,
            (205, 135, 45)
        )

        # Эчке өлеш
        inner_points = []

        for px, py in base_points:

            px *= 0.78
            py *= 0.78

            rx = (
                px * math.cos(angle)
                - py * math.sin(angle)
            )

            ry = (
                px * math.sin(angle)
                + py * math.cos(angle)
            )

            inner_points.append(
                (
                    center_x + rx,
                    center_y + ry
                )
            )

        arcade.draw_polygon_filled(
            inner_points,
            (245, 180, 70)
        )

        # Контур
        arcade.draw_polygon_outline(
            points,
            arcade.color.WHITE,
            2
        )

        # Урта
        arcade.draw_circle_filled(
            self.x,
            self.y,
            self.size * 0.12,
            (130, 75, 20)
        )

        # Эчпочмак сызыклары
        for i in range(3):

            a = math.radians(
                self.rotation
                + i * 120
            )

            x2 = (
                self.x
                + math.cos(a)
                * self.size * 0.55
            )

            y2 = (
                self.y
                + math.sin(a)
                * self.size * 0.55
            )

            arcade.draw_line(
                self.x,
                self.y,
                x2,
                y2,
                (150, 90, 25),
                2
            )

    # ========================================================
    # ЭЛЕШ
    # ========================================================

    def draw_elesh(self):

        # Тышкы өлеш
        arcade.draw_circle_filled(
            self.x,
            self.y,
            self.size * 0.82,
            (220, 170, 90)
        )

        # Эчке өлеш
        arcade.draw_circle_filled(
            self.x,
            self.y + self.size * 0.05,
            self.size * 0.68,
            (250, 205, 125)
        )

        # Өстендәге җыерчыклар
        fold_count = 8

        for i in range(fold_count):

            angle = math.radians(
                i * (360 / fold_count)
                + self.rotation * 0.15
            )

            start_x = (
                self.x
                + math.cos(angle)
                * self.size * 0.20
            )

            start_y = (
                self.y
                + math.sin(angle)
                * self.size * 0.20
            )

            end_x = (
                self.x
                + math.cos(angle)
                * self.size * 0.62
            )

            end_y = (
                self.y
                + math.sin(angle)
                * self.size * 0.62
            )

            arcade.draw_line(
                start_x,
                start_y,
                end_x,
                end_y,
                (180, 120, 55),
                2
            )

        # Урта
        arcade.draw_circle_filled(
            self.x,
            self.y + self.size * 0.03,
            self.size * 0.12,
            (180, 120, 50)
        )

        # Контур
        arcade.draw_circle_outline(
            self.x,
            self.y,
            self.size * 0.82,
            arcade.color.WHITE,
            2
        )

    # ========================================================
    # ЧАК-ЧАК
    # ========================================================

    def draw_chak_chak(self):

        # Чак-чакның кисәкләре
        pieces = [
            (-0.42, 0.18, 0.25),
            (-0.15, 0.35, 0.28),
            (0.18, 0.32, 0.25),
            (0.43, 0.12, 0.22),

            (-0.38, -0.15, 0.24),
            (-0.10, -0.05, 0.28),
            (0.18, -0.08, 0.26),
            (0.40, -0.22, 0.23),

            (-0.20, -0.35, 0.24),
            (0.10, -0.32, 0.26)
        ]

        # Бал
        arcade.draw_circle_filled(
            self.x,
            self.y,
            self.size * 0.82,
            (235, 170, 35)
        )

        for px, py, radius in pieces:

            x = (
                self.x
                + px * self.size
            )

            y = (
                self.y
                + py * self.size
            )

            r = (
                radius
                * self.size
            )

            # Кисәк
            arcade.draw_circle_filled(
                x,
                y,
                r,
                (215, 145, 35)
            )

            # Якты өлеш
            arcade.draw_circle_filled(
                x - r * 0.25,
                y + r * 0.25,
                r * 0.45,
                (250, 190, 60)
            )

        # Балның агып торган өлешләре
        honey_lines = [
            (-0.45, 0.65, -0.35, 0.35),
            (-0.05, 0.72, -0.02, 0.42),
            (0.35, 0.62, 0.30, 0.30)
        ]

        for (
            x1,
            y1,
            x2,
            y2
        ) in honey_lines:

            arcade.draw_line(
                self.x + x1 * self.size,
                self.y + y1 * self.size,
                self.x + x2 * self.size,
                self.y + y2 * self.size,
                (255, 205, 70),
                5
            )

        # Контур
        arcade.draw_circle_outline(
            self.x,
            self.y,
            self.size * 0.82,
            arcade.color.WHITE,
            2
        )

        # Яшел плюс — бу объектның дәвалаучы
        # икәнен күрсәтү өчен
        arcade.draw_line(
            self.x - self.size * 0.28,
            self.y + self.size * 0.92,
            self.x + self.size * 0.28,
            self.y + self.size * 0.92,
            arcade.color.GREEN,
            4
        )

        arcade.draw_line(
            self.x,
            self.y + self.size * 0.64,
            self.x,
            self.y + self.size * 1.20,
            arcade.color.GREEN,
            4
        )

    # ========================================================
    # РИСОВАНИЕ
    # ========================================================

    def draw(self):

        if self.kind == "ASTEROID":

            self.draw_real_asteroid()

        elif self.kind == "ECHPOCHMAK":

            self.draw_echpochmak()

        elif self.kind == "ELESH":

            self.draw_elesh()

        elif self.kind == "CHAK_CHACK":

            self.draw_chak_chak()


