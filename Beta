# КОСМОС САКЧЫСЫ
# ============================================================

class SpaceDefender(arcade.Window):

    def __init__(self):

        super().__init__(
            SCREEN_WIDTH,
            SCREEN_HEIGHT,
            SCREEN_TITLE
        )

        arcade.set_background_color(
            arcade.color.BLACK
        )

        self.game_state = "MENU"

        # Рекорд
        self.high_score = (
            self.load_high_score()
        )

        # ----------------------------------------------------
        # СЕЗ
        # ----------------------------------------------------

        self.player_x = (
            SCREEN_WIDTH // 2
        )

        self.player_y = 100

        self.player_width = 50
        self.player_height = 35

        self.player_health = 100
        self.player_max_health = 100

        self.player_invulnerable = 0

        # ----------------------------------------------------
        # ОБЪЕКТЛАР
        # ----------------------------------------------------

        self.bullets = []
        self.asteroids = []
        self.particles = []
        self.stars = []

        # ----------------------------------------------------
        # СТАТИСТИКА
        # ----------------------------------------------------

        self.score = 0
        self.level = 1
        self.game_time = 0

        self.asteroids_destroyed = 0

        # Чак-чакларның һәр дәрәҗәдә 2 тапкыр
        # чыгуын контрольдә тотабыз
        self.chak_chak_spawned = set()

        # ----------------------------------------------------
        # АТУ
        # ----------------------------------------------------

        self.shoot_timer = 0
        self.can_shoot = True

        # ----------------------------------------------------
        # КЛАВИШЫ
        # ----------------------------------------------------

        self.left_pressed = False
        self.right_pressed = False
        self.space_pressed = False

        # Яңа рекорд
        self.new_record = False

        self.setup()

    # ========================================================
    # РЕКОРДНЫ ЙӨКЛӘҮ
    # ========================================================

    def load_high_score(self):

        try:

            if os.path.exists(
                HIGH_SCORE_FILE
            ):

                with open(
                    HIGH_SCORE_FILE,
                    "r",
                    encoding="utf-8"
                ) as file:

                    data = json.load(file)

                    return data.get(
                        "high_score",
                        0
                    )

        except Exception as error:

            print(
                f"Рекордны йөкләү хатасы: {error}"
            )

        return 0

    # ========================================================
    # РЕКОРДНЫ САКЛАУ
    # ========================================================

    def save_high_score(self):

        if self.score > self.high_score:

            self.high_score = self.score

            try:

                with open(
                    HIGH_SCORE_FILE,
                    "w",
                    encoding="utf-8"
                ) as file:

                    json.dump(
                        {
                            "high_score":
                                self.high_score
                        },
                        file,
                        ensure_ascii=False,
                        indent=4
                    )

            except Exception as error:

                print(
                    f"Рекордны саклау хатасы: {error}"
                )

    # ========================================================
    # СЕТАП
    # ========================================================

    def setup(self):

        self.stars = []

        for _ in range(220):

            star = Star(
                random.uniform(
                    0,
                    SCREEN_WIDTH
                ),
                random.uniform(
                    0,
                    SCREEN_HEIGHT
                ),
                random.uniform(1, 3),
                (255, 255, 255),
                random.uniform(1, 3),
                random.uniform(0, 6.28)
            )

            self.stars.append(
                star
            )

    # ========================================================
    # ЯҢА УЕН
    # ========================================================

    def start_game(self):

        self.game_state = "PLAYING"

        self.player_x = (
            SCREEN_WIDTH // 2
        )

        self.player_y = 100

        self.player_health = (
            self.player_max_health
        )

        self.player_invulnerable = 0

        # Объектлар
        self.bullets.clear()
        self.asteroids.clear()
        self.particles.clear()

        # Статистика
        self.score = 0
        self.level = 1
        self.game_time = 0

        self.asteroids_destroyed = 0

        # Чак-чаклар
        self.chak_chak_spawned = set()

        # Ату
        self.shoot_timer = 0
        self.can_shoot = True

        # Клавишы
        self.left_pressed = False
        self.right_pressed = False
        self.space_pressed = False

        self.new_record = False

    # ========================================================
    # DRAW
    # ========================================================

    def on_draw(self):

        self.clear()

        if self.game_state == "MENU":

            self.draw_menu()

        elif self.game_state == "PLAYING":

            self.draw_game()

        elif self.game_state == "GAME_OVER":

            self.draw_game_over()

    # ========================================================
    # UPDATE
    # ========================================================

    def on_update(self, delta_time):

        self.game_time += delta_time

        # Йолдызлар
        for star in self.stars:

            star.update(delta_time)

        if self.game_state == "PLAYING":

            self.update_game(
                delta_time
            )

