    # ========================================================
    # УЕН ЛОГИКАСЫ
    # ========================================================

    def update_game(
        self,
        delta_time
    ):

        # ====================================================
        # ХӘРӘКӘТ
        # ====================================================

        if self.left_pressed:

            self.player_x -= PLAYER_SPEED

        if self.right_pressed:

            self.player_x += PLAYER_SPEED

        # Экран чикләре
        self.player_x = max(
            self.player_width // 2,
            min(
                SCREEN_WIDTH
                - self.player_width // 2,
                self.player_x
            )
        )

        # ====================================================
        # ДӘРӘҖӘНЕ БИЛГЕЛӘҮ
        # ====================================================

        new_level = (
            1
            + int(
                self.game_time // 30
            )
        )

        # Яңа дәрәҗә башланса
        if new_level != self.level:

            self.level = new_level

            # Яңа дәрәҗә өчен чак-чаклар
            # яңадан 2 тапкыр чыга ала
            self.chak_chak_spawned = set()

        # ====================================================
        # ЧАК-ЧАКНЫ 2 ТАПКЫР ЧЫГАРУ
        # ====================================================

        # Дәрәҗә эчендәге вакыт
        level_time = (
            self.game_time
            % 30
        )

        # Беренче чак-чак — 10 секундта
        if (
            level_time >= 10
            and 10 not in self.chak_chak_spawned
        ):

            self.spawn_chak_chak()

            self.chak_chak_spawned.add(
                10
            )

        # Икенче чак-чак — 20 секундта
        if (
            level_time >= 20
            and 20 not in self.chak_chak_spawned
        ):

            self.spawn_chak_chak()

            self.chak_chak_spawned.add(
                20
            )

        # ====================================================
        # НЕУЯЗВИМОСТЬ
        # ====================================================

        if self.player_invulnerable > 0:

            self.player_invulnerable -= (
                delta_time
            )

            if self.player_invulnerable < 0:

                self.player_invulnerable = 0

        # ====================================================
        # АТУ
        # ====================================================

        if (
            self.space_pressed
            and self.can_shoot
            and len(self.bullets)
            < MAX_BULLETS
        ):

            bullet = Bullet(
                self.player_x,
                self.player_y
                + self.player_height // 2
            )

            self.bullets.append(
                bullet
            )

            self.can_shoot = False

            self.shoot_timer = (
                SHOOT_DELAY
            )

        if not self.can_shoot:

            self.shoot_timer -= (
                delta_time
            )

            if self.shoot_timer <= 0:

                self.can_shoot = True

        # ====================================================
        # ПУЛЯЛӘР
        # ====================================================

        for bullet in self.bullets[:]:

            bullet.update(
                delta_time
            )

            if bullet.y > (
                SCREEN_HEIGHT + 30
            ):

                self.bullets.remove(
                    bullet
                )

        # ====================================================
        # ОБЪЕКТЛАРНЫ ЧЫГАРУ
        # ====================================================

        spawn_chance = (
            0.018
            + self.level * 0.004
        )

        if random.random() < spawn_chance:

            # Астероидлар күбрәк
            kind = random.choices(
                [
                    "ASTEROID",
                    "ECHPOCHMAK",
                    "ELESH"
                ],
                weights=[
                    60,
                    20,
                    20
                ],
                k=1
            )[0]

            speed_bonus = min(
                self.level * 0.15,
                2.0
            )

            asteroid = Asteroid(
                random.uniform(
                    60,
                    SCREEN_WIDTH - 60
                ),
                SCREEN_HEIGHT + 60,
                random.uniform(
                    30,
                    55
                ),
                random.uniform(
                    -1.5,
                    1.5
                ),
                random.uniform(
                    -3.5 - speed_bonus,
                    -2.0 - speed_bonus
                ),
                kind
            )

            self.asteroids.append(
                asteroid
            )

        # ====================================================
        # ОБЪЕКТЛАР
        # ====================================================

        for asteroid in self.asteroids[:]:

            asteroid.update(
                delta_time
            )

            # Экраннан чыгып китсә
            if asteroid.y < -100:

                if asteroid in self.asteroids:

                    self.asteroids.remove(
                        asteroid
                    )

                continue

            # =================================================
            # СЕЗ БЕЛӘН БӘРЕЛЕШ
            # =================================================

            if self.player_invulnerable <= 0:

                if asteroid.collides_with(
                    self.player_x,
                    self.player_y,
                    self.player_width // 2
                ):

                    # Чак-чак белән бәрелешү
                    # сәламәтлекне кире кайтармый,
                    # бары тик атып юк итәргә кирәк
                    if asteroid.kind == "CHAK_CHACK":

                        # Чак-чак корабка зыян китерә
                        self.player_health -= 20

                    else:

                        self.player_health -= 20

                    self.player_invulnerable = 1.0

                    if asteroid in self.asteroids:

                        self.asteroids.remove(
                            asteroid
                        )

                    self.create_explosion(
                        asteroid.x,
                        asteroid.y,
                        (255, 60, 60),
                        15
                    )

                    continue

            # =================================================
            # ПУЛЯ БЕЛӘН БӘРЕЛЕШ
            # =================================================

            for bullet in self.bullets[:]:

                if asteroid.collides_with(
                    bullet.x,
                    bullet.y,
                    3
                ):

                    # Пуляне юк итәбез
                    if bullet in self.bullets:

                        self.bullets.remove(
                            bullet
                        )

                    asteroid.health -= 1

                    # Кечкенә шартлау
                    self.create_explosion(
                        bullet.x,
                        bullet.y,
                        (255, 210, 80),
                        5
                    )

                    # =================================================
                    # ОБЪЕКТ ТУЛЫСЫНЧА ЮК ИТЕЛДЕ
                    # =================================================

                    if asteroid.health <= 0:

                        # =============================================
                        # АСТЕРОИД
                        # =============================================

                        if asteroid.kind == "ASTEROID":

                            self.score += 10

                            self.asteroids_destroyed += 1

                            self.create_explosion(
                                asteroid.x,
                                asteroid.y,
                                (100, 200, 255),
                                20
                            )

                        # =============================================
                        # ЭЧПОЧМАК
                        # =============================================

                        elif (
                            asteroid.kind
                            == "ECHPOCHMAK"
                        ):

                            self.score -= 10

                            self.score = max(
                                0,
                                self.score
                            )

                            self.create_explosion(
                                asteroid.x,
                                asteroid.y,
                                (255, 80, 50),
                                20
                            )

                        # =============================================
                        # ЭЛЕШ
                        # =============================================

                        elif (
                            asteroid.kind
                            == "ELESH"
                        ):

                            self.score -= 15

                            self.score = max(
                                0,
                                self.score
                            )

                            self.create_explosion(
                                asteroid.x,
                                asteroid.y,
                                (255, 120, 50),
                                20
                            )

                        # =============================================
                        # ЧАК-ЧАК
                        # =============================================

                        elif (
                            asteroid.kind
                            == "CHAK_CHACK"
                        ):

                            # Сәламәтлекне +15 арттырабыз
                            self.player_health = min(
                                self.player_max_health,
                                self.player_health
                                + CHAK_CHACK_HEAL
                            )

                            # Яшел шартлау
                            self.create_explosion(
                                asteroid.x,
                                asteroid.y,
                                (80, 255, 120),
                                25
                            )

                        # Объектны бетерү
                        if asteroid in self.asteroids:

                            self.asteroids.remove(
                                asteroid
                            )

                    # Бер пуля бер объектка гына тия
                    break

        # ====================================================
        # КИСӘКЛӘР
        # ====================================================

        for particle in self.particles[:]:

            particle.update(
                delta_time
            )

            if not particle.is_alive():

                self.particles.remove(
                    particle
                )

        # ====================================================
        # УЕН БЕТҮ
        # ====================================================

        if self.player_health <= 0:

            self.player_health = 0

            self.game_state = (
                "GAME_OVER"
            )

            self.new_record = (
                self.score
                > self.high_score
            )

            self.save_high_score()

    # ========================================================
    # ШАРЛАУ
    # ========================================================

    def create_explosion(
        self,
        x,
        y,
        color,
        count
    ):

        for _ in range(count):

            angle = random.uniform(
                0,
                math.pi * 2
            )

            speed = random.uniform(
                1,
                5
            )

            particle = Particle(
                x,
                y,
                math.cos(angle) * speed,
                math.sin(angle) * speed,
                random.uniform(2, 5),
                color,
                random.uniform(
                    0.4,
                    1.0
                )
            )

            self.particles.append(
                particle
            )

    # ========================================================
    # КЛАВИШЫ
    # ========================================================

    def on_key_press(
        self,
        key,
        modifiers
    ):

        # ====================================================
        # МЕНЮ
        # ====================================================

        if self.game_state == "MENU":

            if (
                key == arcade.key.SPACE
                or key == arcade.key.ENTER
            ):

                self.start_game()

            elif key == arcade.key.ESCAPE:

                arcade.close_window()

        # ====================================================
        # УЕН
        # ====================================================

        elif self.game_state == "PLAYING":

            if key == arcade.key.LEFT:

                self.left_pressed = True

            elif key == arcade.key.RIGHT:

                self.right_pressed = True

            elif key == arcade.key.SPACE:

                self.space_pressed = True

            elif key == arcade.key.ESCAPE:

                self.game_state = "MENU"

                self.setup()

        # ====================================================
        # УЕН ТӘМАМЛАНДЫ
        # ====================================================

        elif self.game_state == "GAME_OVER":

            if key == arcade.key.R:

                self.start_game()

            elif key == arcade.key.ESCAPE:

                self.game_state = "MENU"

                self.setup()

    # ========================================================
    # КЛАВИШАНЫ ҖИБӘРҮ
    # ========================================================

    def on_key_release(
        self,
        key,
        modifiers
    ):

        if self.game_state == "PLAYING":

            if key == arcade.key.LEFT:

                self.left_pressed = False

            elif key == arcade.key.RIGHT:

                self.right_pressed = False

            elif key == arcade.key.SPACE:

                self.space_pressed = False

    # ========================================================
    # ТЫШЧКАН
    # ========================================================

    def on_mouse_press(
        self,
        x,
        y,
        button,
        modifiers
    ):

        if button != arcade.MOUSE_BUTTON_LEFT:

            return

        center_x = (
            SCREEN_WIDTH // 2
        )

        # ====================================================
        # МЕНЮ
        # ====================================================

        if self.game_state == "MENU":

            if (
                center_x - 110
                <= x
                <= center_x + 110
                and 137 <= y <= 192
            ):

                self.start_game()

        # ====================================================
        # УЕН ТӘМАМЛАНДЫ
        # ====================================================

        elif self.game_state == "GAME_OVER":

            # Яңа уен
            if (
                center_x - 100
                <= x
                <= center_x + 100
                and 125 <= y <= 175
            ):

                self.start_game()

            # Менюга кайту
            elif (
                center_x - 100
                <= x
                <= center_x + 100
                and 75 <= y <= 125
            ):

                self.game_state = "MENU"

                self.setup()


